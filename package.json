{
  "name": "no-frills-focus",
  "version": "0.1.13",
  "description": "A commitment enforcement tool for macOS",
  "main": "main.js",
  "author": "No Frills Focus",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac --dir",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "@electron/notarize": "^2.1.0",
    "dotenv": "^16.6.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nofrillsfocus.app",
    "productName": "No Frills Focus",
    "afterSign": "scripts/notarize.js",
    "icon": "build/icons/icon.icns",
    "files": [
      "**/*",
      "!dist",
      "!dmg",
      "!build",
      "!*.dmg",
      "!*.zip"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  }
}
